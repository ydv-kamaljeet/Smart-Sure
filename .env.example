# ── SQL Server ────────────────────────────────────────────────────────────────
SQL_SA_PASSWORD=YourStrongPassword@2024
ConnectionStrings__IdentityDb=Server=localhost;Database=SmartSure_IdentityDB;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True
ConnectionStrings__PolicyDb=Server=localhost;Database=SmartSure_PolicyDB;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True
ConnectionStrings__ClaimsDb=Server=localhost;Database=SmartSure_ClaimsDB;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True
ConnectionStrings__AdminDb=Server=localhost;Database=SmartSure_AdminDB;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_USER=smartsure
RABBITMQ_PASS=smartsure_dev

# ── JWT RSA Keys ──────────────────────────────────────────────────────────────
# Generate your own with: dotnet run --project KeyGen/KeyGen
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN RSA PUBLIC KEY-----\n...\n-----END RSA PUBLIC KEY-----"

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Get from https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5001/api/auth/google/callback

# ── Mail / SMTP ───────────────────────────────────────────────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_SENDER_NAME=SmartSure Support
MAIL_SENDER_EMAIL=your-email@gmail.com
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password

# ── MEGA Storage ──────────────────────────────────────────────────────────────
MEGA_EMAIL=your-mega-email@gmail.com
MEGA_PASSWORD=your-mega-password

# ── App URLs ──────────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:4200
ALLOWED_ORIGINS=http://localhost:4200
